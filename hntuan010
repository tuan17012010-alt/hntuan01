  { name:'GOLD I',      icon:'🥇', minRP:750,  maxRP:950 },
  { name:'GOLD II',     icon:'🥇', minRP:950,  maxRP:1150 },
  { name:'GOLD III',    icon:'🥇', minRP:1150, maxRP:1350 },
  { name:'PLATINUM',    icon:'💎', minRP:1350, maxRP:1600 },
