      if (keys.aim || hack.aim) sens *= settings.aimSens;
      cam.yaw -= e.movementX * sens;
      cam.pitch -= e.movementY * sens;
      cam.pitch = Math.max(-0.9, Math.min(0.45, cam.pitch));
    }
  });
  renderer.domElement.addEventListener('click', () => {
    if (state.running && !state.paused) renderer.domElement.requestPointerLock();
  });
  renderer.domElement.addEventListener('mousedown', e => {
    if (e.button === 0) mouseDown = true;
    if (e.button === 2) keys.aim = true;
  });
  addEventListener('mouseup', e => {
    if (e.button === 0) mouseDown = false;
    if (e.button === 2) keys.aim = false;
  });
  addEventListener('contextmenu', e => e.preventDefault());

  setupHackMenu(); setupDragMenu(); animate();
}

