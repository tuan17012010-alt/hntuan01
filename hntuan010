/* ============ TERRAIN ============ */
function terrainHeight(x, z) {
  const d = Math.sqrt(x*x + z*z);
  const radius = state.mapSize * 0.42;
  if (d > radius) return -3 - Math.min(15, (d - radius) * 0.1);
  let h = 0;
  h += Math.sin(x*0.0018) * 55;
  h += Math.cos(z*0.0021) * 45;
  h += Math.sin((x+z)*0.0035) * 22;
  h += Math.sin(x*0.011) * Math.cos(z*0.012) * 8;
  h += Math.sin(x*0.028) * Math.cos(z*0.026) * 2.5;
  const pd = Math.sqrt(x*x + z*z);
  if (pd < 200) { h *= 0.3; h += 5; }
  if (d > radius - 150) { h *= (radius - d) / 150; h += 0.5; }
  return h;
}

