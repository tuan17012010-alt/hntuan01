/* ============ TEAM SYSTEM ============ */
function spawnTeammate(slot) {
  const names = ['Alpha','Bravo','Charlie','Delta'];
  const a = Math.random() * Math.PI * 2;
  const d = 30 + Math.random() * 40;
  const x = Math.cos(a) * d;
  const z = Math.sin(a) * d;
  const y = terrainHeight(x, z);

  const g = new THREE.Group();
  const vestMat = new THREE.MeshStandardMaterial({ color: 0x2ecc71 });
  const skinMat = new THREE.MeshStandardMaterial({ color: 0xf0c090 });
  const darkMat = new THREE.MeshStandardMaterial({ color: 0x1a4a2a });

  const torso = new THREE.Mesh(new THREE.BoxGeometry(0.7, 0.9, 0.4), vestMat);
  torso.position.y = 1.35; g.add(torso);
  const head = new THREE.Mesh(new THREE.BoxGeometry(0.45, 0.45, 0.45), skinMat);
  head.position.y = 2.0; g.add(head);
  const helmet = new THREE.Mesh(new THREE.BoxGeometry(0.5, 0.25, 0.5), new THREE.MeshStandardMaterial({ color: 0x2ecc71 }));
  helmet.position.y = 2.2; g.add(helmet);
  const legGeo = new THREE.BoxGeometry(0.25, 0.8, 0.28);
  const legL = new THREE.Mesh(legGeo, darkMat); legL.position.set(-0.2, 0.5, 0); g.add(legL);
  const legR = new THREE.Mesh(legGeo, darkMat); legR.position.set(0.2, 0.5, 0); g.add(legR);
  const armGeo = new THREE.BoxGeometry(0.2, 0.7, 0.22);
  const armL = new THREE.Mesh(armGeo, vestMat); armL.position.set(-0.5, 1.35, 0); g.add(armL);
  const armR = new THREE.Mesh(armGeo, vestMat); armR.position.set(0.5, 1.35, 0); g.add(armR);
  const gun = new THREE.Mesh(new THREE.BoxGeometry(0.13, 0.13, 0.9), new THREE.MeshStandardMaterial({ color:0x1a1a1a }));
  gun.position.set(0.35, 1.35, -0.45); g.add(gun);
  const marker = new THREE.Mesh(
    new THREE.ConeGeometry(0.15, 0.3, 6),
    new THREE.MeshBasicMaterial({ color: 0x2ecc71 })
  );
  marker.rotation.x = Math.PI;
  marker.position.y = 3.0;
  g.add(marker);

  g.position.set(x, y + 1, z);
  scene.add(g);

  state.team.push({
    mesh: g, name: names[slot], hp: 100, maxHp: 100,
    slot: slot, alive: true, attackCd: 0,
    legL: legL, legR: legR, walkPhase: 0,
  });
}

function updateTeamAI(ally, dt) {
  if (!ally.alive) return;
  const playerPos = player.mesh.position.clone();
  const allyPos = ally.mesh.position;

  let nearest = null, nearestD = 200;
  for (const bot of state.bots) {
    const d = allyPos.distanceTo(bot.mesh.position);
    if (d < nearestD && hasLineOfSight(allyPos, bot.mesh.position)) {
      nearestD = d;
      nearest = bot;
    }
  }

  const mv = new THREE.Vector3();
  let targetYaw = ally.mesh.rotation.y;

  if (nearest && nearestD < 200) {
    const toBot = new THREE.Vector3().subVectors(nearest.mesh.position, allyPos);
    toBot.y = 0; toBot.normalize();
    targetYaw = Math.atan2(toBot.x, toBot.z);
    if (nearestD > 30) mv.copy(toBot);
    else if (nearestD < 15) mv.copy(toBot).multiplyScalar(-1);
    else {
      const strafe = new THREE.Vector3(-toBot.z, 0, toBot.x);
      mv.copy(strafe);
    }
    ally.attackCd -= dt;
    if (ally.attackCd <= 0 && nearestD < 100) {
      const hitChance = 0.5 * (1 - nearestD / 200);
      if (Math.random() < hitChance) {
        nearest.hp -= 15 + Math.random() * 15;
        if (nearest.hp <= 0 && state.bots.includes(nearest)) {
          scene.remove(nearest.mesh);
          state.bots.splice(state.bots.indexOf(nearest), 1);
          addRankPoints(3);
        }
      }
      ally.attackCd = 0.8 + Math.random() * 0.6;
    }
  } else {
    const toPlayer = new THREE.Vector3().subVectors(playerPos, allyPos);
    toPlayer.y = 0;
    const dist = toPlayer.length();
    if (dist > 15) {
      toPlayer.normalize();
      mv.copy(toPlayer);
      targetYaw = Math.atan2(mv.x, mv.z);
    }
  }

  if (mv.length() > 0) {
    mv.normalize();
    const next = allyPos.clone().add(mv.clone().multiplyScalar(6 * dt));
    if (!collidesWithWorld(next)) { allyPos.x = next.x; allyPos.z = next.z; }
  }
  ally.mesh.rotation.y += (targetYaw - ally.mesh.rotation.y) * Math.min(1, 6 * dt);
  allyPos.y = terrainHeight(allyPos.x, allyPos.z) + 1;

  if (mv.length() > 0.1) {
    ally.walkPhase += dt * 12;
    const amp = Math.sin(ally.walkPhase) * 0.4;
    ally.legL.position.z = amp;
    ally.legR.position.z = -amp;
  }
}

