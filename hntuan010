  for (const bot of state.bots) {
    const tp = hack.headshot ? getBotHeadPos(bot) : getBotBodyPos(bot);
    const sp = tp.clone().project(camera);
    if (sp.z > 1) continue;
    const dist = Math.hypot(sp.x * innerWidth/2, -sp.y * innerHeight/2);
    if (dist < hack.aimFov && dist < bestD) { bestD = dist; best = bot; }
  }
  return best;
}
function getAimOrigin() {
  const o = player.mesh.position.clone(); o.y += 1.4;
  const r = new THREE.Vector3(Math.cos(cam.yaw), 0, -Math.sin(cam.yaw));
  o.addScaledVector(r, 0.35); return o;
}
function getAimTarget() {
  const rc = new THREE.Raycaster();
  rc.setFromCamera(new THREE.Vector2(0, 0), camera);
  return camera.position.clone().add(rc.ray.direction.clone().multiplyScalar(600));
}
function shoot() {
  const w = WEAPONS[currentWeapon];
  if (ws.reloading || ws.cooldown > 0) return;
  if (ws.ammo <= 0 && !hack.ammo) { startReload(); return; }
  if (!hack.ammo) { ws.ammo--; if (weaponSlots[activeSlot]) weaponSlots[activeSlot].ammo = ws.ammo; }
  ws.cooldown = w.fireRate; ws.recoil = settings.recoil;
  const pellets = w.pellets || 1;
  const origin = getAimOrigin();
  const locked = getAutoAimTarget();
  const target = locked ? (hack.headshot ? getBotHeadPos(locked) : getBotBodyPos(locked)) : getAimTarget();
  for (let i = 0; i < pellets; i++) {
    const dir = new THREE.Vector3().subVectors(target, origin).normalize();
    const sp = locked ? 0.002 : w.spread;
    dir.x += (Math.random()-0.5)*sp*2;
    dir.y += (Math.random()-0.5)*sp*2;
    dir.z += (Math.random()-0.5)*sp*2;
    dir.normalize();
    const bulletColor = locked && hack.headshot ? 0xff2222 : (hack.homing ? 0xff8800 : w.color);
    const bm = new THREE.Mesh(
      new THREE.CylinderGeometry(0.05, 0.05, 0.9, 5),
      new THREE.MeshBasicMaterial({ color: bulletColor })
    );
    bm.quaternion.setFromUnitVectors(new THREE.Vector3(0,1,0), dir);
    bm.position.copy(origin); scene.add(bm);
    const trailGeo = new THREE.BufferGeometry();
    const trailPositions = new Float32Array(6);
    trailGeo.setAttribute('position', new THREE.BufferAttribute(trailPositions, 3));
    const trailMat = new THREE.LineBasicMaterial({ color: bulletColor, transparent: true, opacity: 0.8 });
    const trail = new THREE.Line(trailGeo, trailMat);
    trail.frustumCulled = false;
    scene.add(trail);
    state.bullets.push({
      mesh: bm, trail: trail,
      pos: origin.clone(), vel: dir.multiplyScalar(BULLET_SPEED),
      life: BULLET_LIFE, damage: w.damage,
    });
  }
  spawnMuzzleFlash(origin);
  soundShoot();
  cam.shake = Math.min(0.25, cam.shake + settings.recoil * 1.3);
  updateHUD();
}
