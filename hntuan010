<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<title>MAP HNTUAN V13</title>
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<style>
  * { margin:0; padding:0; box-sizing:border-box; }
  html,body { width:100%; height:100%; overflow:hidden; background:#000; font-family:'Courier New',monospace; color:#fff; user-select:none; touch-action:none; }
  button { font-family:inherit; cursor:pointer; }
  .hidden { display:none !important; }

  #loginScreen { position:fixed; inset:0; z-index:110; display:none; overflow:hidden;
    background:linear-gradient(135deg,#1a0a05 0%,#2a0f08 30%,#0a0a15 100%); }
  #loginScreen.show { display:block; }
  .login-bg { position:absolute; inset:0;
    background: radial-gradient(circle at 20% 80%, rgba(255,140,0,0.35), transparent 50%),
                radial-gradient(circle at 80% 20%, rgba(255,60,0,0.3), transparent 50%),
                radial-gradient(circle at 50% 50%, rgba(255,200,80,0.15), transparent 60%);
    animation: loginPulse 4s ease-in-out infinite; }
  @keyframes loginPulse { 0%,100%{opacity:0.9;} 50%{opacity:1;} }
  .login-logo { position:absolute; top:20px; right:30px; font-size:32px; font-weight:900;
    color:#f39c12; letter-spacing:3px; font-style:italic; z-index:2; }
  .login-logo span { color:#e74c3c; font-size:18px; display:block; text-align:right; letter-spacing:6px; margin-top:-6px; }
  .login-recover { position:absolute; top:20px; left:20px; color:#fff; font-size:12px;
    background:rgba(0,0,0,0.5); padding:6px 12px; border-radius:4px; cursor:pointer;
    border:1px solid rgba(255,255,255,0.15); z-index:2; }
  .login-version { position:absolute; top:60px; left:20px; color:#fff; font-size:11px; z-index:2; }
  .login-age { position:absolute; bottom:100px; left:30px; display:flex; align-items:center; gap:12px; max-width:320px; z-index:2; }
  .age-badge { background:#fff; color:#000; font-size:22px; font-weight:900; padding:6px 12px; border:2px solid #000; }
  .age-text { color:#fff; font-size:10px; line-height:1.4; }
  .login-terms { position:absolute; bottom:60px; left:30px; display:flex; flex-direction:column; gap:4px; color:#fff; font-size:11px; z-index:2; }
  .login-terms u { color:#f39c12; cursor:pointer; }
  .login-buttons { position:absolute; bottom:80px; left:50%; transform:translateX(-50%);
    display:flex; flex-direction:column; align-items:center; gap:12px; width:340px; z-index:2; }
  .login-btn { width:100%; padding:14px 20px; font-size:15px; font-weight:bold; border:none; border-radius:4px;
    transition:0.2s; display:flex; align-items:center; justify-content:center; gap:10px; color:#fff; }
  .login-btn:hover { transform:translateY(-2px); }
  .login-btn.facebook { background:linear-gradient(180deg,#1877f2,#0d5dc7); }
  .fb-icon { background:#fff; color:#1877f2; width:24px; height:24px; border-radius:50%;
    display:flex; align-items:center; justify-content:center; font-weight:900; font-family:Arial; }
  .login-or { color:#aaa; font-size:12px; font-style:italic; }
  .login-row { display:flex; gap:12px; width:100%; }
  .login-btn.guest, .login-btn.more { flex:1; padding:12px 10px;
    background:rgba(255,255,255,0.12); border:1px solid rgba(255,255,255,0.25); font-size:14px; }
  #loginLoading { position:fixed; inset:0; z-index:120; background:rgba(0,0,0,0.92);
    display:none; flex-direction:column; align-items:center; justify-content:center; gap:20px; }
  #loginLoading.show { display:flex; }
  .load-spinner { width:60px; height:60px; border:4px solid rgba(243,156,18,0.3); border-top-color:#f39c12;
    border-radius:50%; animation: spin 0.8s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  #loginLoading .msg { color:#f39c12; letter-spacing:3px; font-size:14px; }

  #lobbyScreen { position:fixed; inset:0; z-index:105; background:#0a0e15; display:none; }
  #lobbyScreen.show { display:block; }
  .lobby-bg { position:absolute; inset:0; background: radial-gradient(ellipse at 50% 30%, #1a3a5a 0%, #0a1525 50%, #050810 100%); }
  #lobbyCanvas { position:absolute; inset:0; z-index:2; pointer-events:none; }
  .lobby-top { position:absolute; top:0; left:0; right:0; height:60px;
    background:linear-gradient(180deg, rgba(0,0,0,0.8), rgba(0,0,0,0.3)); z-index:10;
    display:flex; align-items:center; padding:0 20px; border-bottom:1px solid rgba(100,180,255,0.15); }
  .lobby-profile { display:flex; align-items:center; gap:10px; background:rgba(10,20,30,0.8);
    padding:6px 14px 6px 6px; border-radius:30px; border:1px solid rgba(100,180,255,0.3); }
  .lobby-avatar { width:36px; height:36px; border-radius:50%; background:linear-gradient(135deg,#f39c12,#c0392b);
    display:flex; align-items:center; justify-content:center; font-weight:bold; font-size:16px; border:2px solid #f39c12; }
  .lobby-name { color:#fff; font-size:13px; font-weight:bold; }
  .lobby-id { color:#7fb8d6; font-size:10px; }
  .lobby-currencies { display:flex; gap:8px; margin-left:20px; }
  .lobby-currency { display:flex; align-items:center; gap:6px; background:rgba(0,0,0,0.6);
    padding:6px 14px; border-radius:20px; border:1px solid rgba(243,156,18,0.4);
    color:#f39c12; font-weight:bold; font-size:13px; }
  .lobby-logo { margin-left:auto; font-size:22px; font-weight:900; color:#f39c12;
    letter-spacing:2px; font-style:italic; }
  .lobby-logo span { color:#e74c3c; font-size:12px; display:block; text-align:right; letter-spacing:5px; margin-top:-4px; }
  .lobby-sidebar { position:absolute; left:0; top:70px; display:flex; flex-direction:column;
    gap:6px; z-index:10; padding:10px; }
  .lobby-menu-item { display:flex; align-items:center; gap:10px; padding:10px 16px;
    background:linear-gradient(90deg, rgba(30,50,70,0.9), rgba(20,30,45,0.7));
    border-left:3px solid #f39c12; color:#dde; font-size:12px; letter-spacing:2px;
    cursor:pointer; transition:0.2s; min-width:160px; }
  .lobby-menu-item:hover { background:rgba(243,156,18,0.3); transform:translateX(6px); }
  .lobby-events { position:absolute; top:80px; left:180px; display:flex; gap:12px; z-index:9; }
  .lobby-event-card { width:180px; height:100px; background:linear-gradient(135deg, #c0392b 0%, #7a1e14 100%);
    border:2px solid #f39c12; display:flex; flex-direction:column; align-items:center; justify-content:center; cursor:pointer; }
  .lobby-event-card.small { width:130px; background:linear-gradient(135deg, #2980b9 0%, #154360 100%); }
  .event-tag { color:#fff; font-size:9px; letter-spacing:2px; opacity:0.8; }
  .event-name { color:#fff; font-size:16px; font-weight:bold; text-align:center; }
  .lobby-char-info { position:absolute; bottom:120px; left:50%; transform:translateX(-50%);
    text-align:center; z-index:9; pointer-events:none; }
  .char-name { color:#f39c12; font-size:20px; font-weight:bold; letter-spacing:3px; text-shadow:0 0 10px #f39c12; }
  .char-title { color:#7fb8d6; font-size:11px; letter-spacing:4px; margin-top:4px; }
  .lobby-bottom { position:absolute; bottom:0; left:0; right:0; height:60px;
    background:linear-gradient(0deg, rgba(0,0,0,0.9), rgba(0,0,0,0.3));
    display:flex; align-items:center; justify-content:center; gap:20px; z-index:10;
    border-top:1px solid rgba(100,180,255,0.2); }
  .lobby-tab { display:flex; align-items:center; gap:8px; padding:8px 20px; color:#889;
    font-size:12px; letter-spacing:2px; cursor:pointer; border-bottom:2px solid transparent; }
  .lobby-tab.active { color:#f39c12; border-bottom-color:#f39c12; }
  .lobby-start { position:absolute; right:30px; bottom:80px; padding:14px 40px;
    background:linear-gradient(180deg, #f39c12 0%, #c87f0a 100%); border:2px solid #fff;
    border-radius:4px; z-index:11; min-width:180px; text-align:center; transition:0.2s; }
  .lobby-start:hover { transform:scale(1.05); }
  .lobby-start .start-mode { color:#fff; font-size:10px; letter-spacing:2px; }
  .lobby-start .start-sub { color:rgba(255,255,255,0.7); font-size:9px; margin:2px 0; }
  .lobby-start .start-main { color:#000; font-size:22px; font-weight:900; letter-spacing:3px; }
  .lobby-logout { position:absolute; top:70px; right:20px; width:40px; height:40px;
    background:rgba(192,57,43,0.8); border:2px solid #e74c3c; border-radius:50%;
    color:#fff; font-size:18px; z-index:11; }
  .lobby-logout:hover { background:rgba(192,57,43,1); }

  #hud { position:fixed; inset:0; pointer-events:none; z-index:50; display:none; }
  #hud.show { display:block; }
  .hp-bar { position:absolute; bottom:30px; left:30px; width:300px; }
  .label { font-size:12px; letter-spacing:2px; color:#ccc; margin-bottom:4px; }
  .bar-bg { width:100%; height:16px; background:rgba(0,0,0,.7); border:1px solid #333; margin-bottom:8px; }
  .bar-fill { height:100%; width:100%; background:linear-gradient(90deg,#e74c3c,#ff6b6b); transition:width .2s; }
  .bar-fill.armor { background:linear-gradient(90deg,#3498db,#5dade2); }
  .top-hud { position:absolute; top:20px; left:50%; transform:translateX(-50%);
    display:flex; gap:30px; background:rgba(0,0,0,.6); padding:10px 30px;
    border-radius:30px; border:1px solid #445; font-size:14px; }
  .top-hud span { color:#f39c12; font-weight:bold; }
  .alive { position:absolute; top:20px; left:20px; background:rgba(0,0,0,.6);
    padding:10px 20px; border-left:3px solid #f39c12; }
  .alive .num { font-size:26px; color:#f39c12; font-weight:bold; }
  .weapon-hud { position:absolute; bottom:30px; right:30px; text-align:right; }
  .weapon-name { font-size:18px; letter-spacing:2px; color:#f39c12; }
  .ammo-info { font-size:40px; font-weight:bold; }
  .ammo-info .reserve { font-size:22px; color:#889; }
  #crosshair { position:fixed; top:50%; left:50%; width:20px; height:20px;
    transform:translate(-50%,-50%); z-index:40; pointer-events:none; display:none; }
  #crosshair.show { display:block; }
  #crosshair::before, #crosshair::after { content:''; position:absolute; background:#0f0; }
  #crosshair::before { left:50%; top:0; width:2px; height:100%; transform:translateX(-50%); }
  #crosshair::after { top:50%; left:0; height:2px; width:100%; transform:translateY(-50%); }
  #prompt { position:fixed; top:60%; left:50%; transform:translate(-50%,-50%);
    background:rgba(0,0,0,.85); padding:12px 24px; border:1px solid #f39c12;
    color:#f39c12; z-index:45; display:none; }
  #prompt.show { display:block; }
  .overlay { position:fixed; inset:0; background:rgba(0,0,0,.88); display:none;
    flex-direction:column; align-items:center; justify-content:center; z-index:90; }
  .overlay.show { display:flex; }
  .overlay h2 { font-size:52px; letter-spacing:8px; color:#f39c12; margin-bottom:20px; }
  .menu-btn-lg { padding:14px 40px; margin:10px; background:transparent; border:1px solid #f39c12;
    color:#f39c12; font-size:16px; letter-spacing:2px; }
  .menu-btn-lg:hover { background:#f39c12; color:#000; }
  #minimap { position:fixed; top:20px; right:20px; width:150px; height:150px;
    border:2px solid #445; border-radius:50%; overflow:hidden; z-index:45; display:none; }
  #minimap.show { display:block; }
  #hackToggle { position:fixed; top:20px; right:180px; z-index:80;
    background:rgba(255,0,100,0.85); border:2px solid #fff; color:#fff;
    padding:8px 14px; font-weight:bold; border-radius:4px; }
  #hackMenu { position:fixed; top:70px; right:180px; z-index:80;
    width:290px; max-height:calc(100vh - 100px); overflow-y:auto;
    background:rgba(10,0,20,0.96); border:2px solid #ff0066; border-radius:6px;
    padding:14px; display:none; }
  #hackMenu.show { display:block; }
  #hackMenu h3 { color:#ff0066; font-size:14px; letter-spacing:3px; text-align:center;
    margin-bottom:12px; border-bottom:1px solid #ff0066; padding-bottom:8px; cursor:move; }
  .hack-row { display:flex; align-items:center; justify-content:space-between;
    margin:8px 0; font-size:12px; color:#dde; }
  .hack-row span { flex:1; }
  .hack-row input[type="checkbox"] { width:36px; height:18px; accent-color:#ff0066; }
  .hack-row input[type="range"] { width:80px; accent-color:#ff0066; }
  .hack-row .val { color:#ff0066; font-weight:bold; min-width:40px; text-align:right; }
  .hack-sep { border-top:1px solid #444; margin:10px 0; padding-top:8px;
    color:#ff0066; font-size:11px; text-align:center; }
  #hitmarker { position:fixed; top:50%; left:50%; width:24px; height:24px;
    transform:translate(-50%,-50%) rotate(45deg); z-index:41; pointer-events:none; display:none; }
  #hitmarker.show { display:block; }
  #hitmarker::before, #hitmarker::after { content:''; position:absolute; background:#ffdd00; }
  #hitmarker::before { left:50%; top:0; width:3px; height:100%; transform:translateX(-50%); }
  #hitmarker::after { top:50%; left:0; height:3px; width:100%; transform:translateY(-50%); }
  #damageFlash { position:fixed; inset:0; z-index:39; pointer-events:none;
    box-shadow:inset 0 0 100px rgba(255,0,0,0); transition:box-shadow .15s; }
  #damageFlash.hit { box-shadow:inset 0 0 120px rgba(255,0,0,0.7); }
  #killFeed { position:fixed; top:100px; right:20px; z-index:46; }
  .kill-msg { background:rgba(0,0,0,.7); padding:6px 12px; margin:4px 0;
    border-right:3px solid #ff0066; font-size:12px; }
  #zoneWarning { position:fixed; top:50%; left:50%; transform:translate(-50%,-50%);
    color:#ff0066; font-size:36px; letter-spacing:8px; z-index:48; display:none; }
  #zoneWarning.show { display:block; }
  #enemyCounter { position:fixed; top:100px; right:20px; z-index:47;
    background:rgba(255,0,100,0.15); border:2px solid #ff0066; border-radius:6px;
    padding:8px 16px; font-size:14px; font-weight:bold; color:#fff; display:none; }
  #enemyCounter span { color:#ff0066; font-size:20px; margin-left:6px; }
  #enemyCounter.danger { background:rgba(255,0,0,0.35); }

  /* 🏆 LEADERBOARD */
  #leaderboard {
    position:fixed; top:150px; right:20px; z-index:46;
    width:280px; background:rgba(0,0,0,0.85);
    border:2px solid #f39c12; border-radius:6px;
    padding:10px; display:none;
    box-shadow:0 0 20px rgba(243,156,18,0.5);
  }
  #leaderboard.show { display:block; }
  .lb-header {
    color:#f39c12; font-size:13px; letter-spacing:3px;
    text-align:center; padding-bottom:8px; margin-bottom:8px;
    border-bottom:1px solid #f39c12; font-weight:bold;
  }
  .lb-refresh { color:#666; font-size:9px; }
  .lb-list { display:flex; flex-direction:column; gap:3px; }
  .lb-item {
    display:flex; align-items:center; gap:8px;
    padding:4px 8px; background:rgba(20,30,45,0.7);
    border-left:3px solid #666; font-size:11px;
  }
  .lb-item.me {
    background:linear-gradient(90deg, rgba(243,156,18,0.3), rgba(20,30,45,0.7));
    border-left-color:#f39c12; color:#fff; font-weight:bold;
  }
  .lb-rank { width:20px; text-align:center; font-weight:bold; color:#f39c12; }
  .lb-rank.r1 { color:#ffd700; } .lb-rank.r2 { color:#c0c0c0; } .lb-rank.r3 { color:#cd7f32; }
  .lb-name { flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .lb-kills { color:#ff0066; font-weight:bold; }

  /* 👥 TEAM LIST */
  #teamList {
    position:fixed; top:470px; right:20px; z-index:46;
    width:280px; background:rgba(0,0,0,0.85);
    border:2px solid #3498db; border-radius:6px;
    padding:10px; display:none;
    box-shadow:0 0 20px rgba(52,152,219,0.5);
  }
  #teamList.show { display:block; }
  .tl-header {
    color:#3498db; font-size:12px; letter-spacing:3px;
    text-align:center; padding-bottom:8px; margin-bottom:8px;
    border-bottom:1px solid #3498db; font-weight:bold;
  }
  .tl-list { display:flex; flex-direction:column; gap:4px; }
  .tl-item {
    display:flex; align-items:center; gap:8px;
    padding:5px 8px; background:rgba(20,30,45,0.7);
    border-left:3px solid #3498db; font-size:11px;
  }
  .tl-item.me {
    background:linear-gradient(90deg, rgba(52,152,219,0.3), rgba(20,30,45,0.7));
    border-left-color:#f39c12;
  }
  .tl-item.dead { opacity:0.4; border-left-color:#666; }
  .tl-hp { width:50px; height:6px; background:rgba(0,0,0,0.8); border:1px solid #333; }
  .tl-hp-fill { height:100%; background:linear-gradient(90deg,#e74c3c,#ff6b6b); transition:width 0.3s; }
  .tl-name { flex:1; color:#fff; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .tl-status { color:#2ecc71; font-size:10px; }
  .tl-status.dead { color:#666; }

  /* 🏅 RANK BADGE */
  #rankBadge {
    position:fixed; bottom:180px; left:30px; z-index:46;
    display:none; align-items:center; gap:10px;
    background:linear-gradient(135deg, #1a1a2a, #0a0a15);
    border:2px solid #f39c12; border-radius:8px;
    padding:10px 16px;
    box-shadow:0 0 20px rgba(243,156,18,0.4);
  }
  #rankBadge.show { display:flex; }
  .rank-icon {
    width:48px; height:48px; border-radius:50%;
    background:radial-gradient(circle, #f39c12, #7a4a00);
    display:flex; align-items:center; justify-content:center;
    font-size:24px; font-weight:900;
    border:3px solid #fff;
  }
  .rank-info { display:flex; flex-direction:column; gap:2px; }
  .rank-name { color:#f39c12; font-size:14px; font-weight:900; letter-spacing:2px; }
  .rank-points { color:#fff; font-size:11px; }
  .rank-progress {
    width:100px; height:5px; background:rgba(0,0,0,0.7);
    border-radius:3px; overflow:hidden; margin-top:3px;
  }
  .rank-progress-fill {
    height:100%; background:linear-gradient(90deg,#f39c12,#e74c3c);
    transition:width 0.5s;
  }

  .rank-up-notif {
    position:fixed; top:50%; left:50%; transform:translate(-50%,-50%);
    background:linear-gradient(135deg, #f39c12, #c0392b);
    border:3px solid #fff; border-radius:12px;
    padding:30px 60px; z-index:200;
    text-align:center;
    box-shadow:0 0 60px rgba(243,156,18,0.9);
    animation:rankUpAnim 3s forwards;
  }
  @keyframes rankUpAnim {
    0% { opacity:0; transform:translate(-50%,-50%) scale(0.3); }
    15% { opacity:1; transform:translate(-50%,-50%) scale(1.15); }
    25% { transform:translate(-50%,-50%) scale(1); }
    80% { opacity:1; }
    100% { opacity:0; transform:translate(-50%,-50%) scale(1.5); }
  }
  .rank-up-icon { font-size:80px; margin-bottom:10px; }
  .rank-up-title { color:#fff; font-size:24px; letter-spacing:6px; font-weight:900; text-shadow:0 3px 6px #000; }
  .rank-up-rank { color:#fff; font-size:32px; letter-spacing:4px; font-weight:900; margin-top:10px; text-shadow:0 0 20px #fff; }

  #teamSelect {
    position:absolute; top:200px; left:180px; z-index:10;
    background:rgba(0,0,0,0.85); border:2px solid #3498db;
    border-radius:6px; padding:12px; width:220px;
  }
  #teamSelect h4 {
    color:#3498db; font-size:12px; letter-spacing:3px;
    text-align:center; margin-bottom:10px;
    padding-bottom:6px; border-bottom:1px solid #3498db;
  }
  .team-opt {
    display:flex; align-items:center; gap:8px;
    padding:6px 10px; margin:3px 0;
    background:rgba(20,30,45,0.7);
    border-left:3px solid #666; cursor:pointer;
    font-size:11px; transition:0.2s;
  }
  .team-opt:hover { background:rgba(52,152,219,0.3); }
  .team-opt.active {
    background:rgba(52,152,219,0.4);
    border-left-color:#f39c12; color:#f39c12;
  }

  @keyframes ksAnim {
    0% { opacity:0; transform:translate(-50%,-50%) scale(0.5); }
    20% { opacity:1; transform:translate(-50%,-50%) scale(1.2); }
    30% { transform:translate(-50%,-50%) scale(1); }
    80% { opacity:1; }
    100% { opacity:0; transform:translate(-50%,-90%) scale(0.9); }
  }
</style>
</head>
<body>

<div id="loginScreen" class="show">
  <div class="login-bg"></div>
  <div class="login-logo">HNTUAN<span>MAX</span></div>
  <div class="login-recover">👤 KHÔI PHỤC TÀI KHOẢN</div>
  <div class="login-version">2.132.11</div>
  <div class="login-age">
    <div class="age-badge">18+</div>
    <div class="age-text">Chơi hơn 180 phút mỗi ngày có thể ảnh hưởng đến sức khỏe của bạn</div>
  </div>
  <div class="login-terms">
    <div>✓ Đã đọc và đồng ý với <u>Thỏa thuận</u></div>
    <div>✓ Tôi xác nhận rằng thông tin và tuổi của tôi đúng</div>
