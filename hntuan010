/* ============ RANK SYSTEM ============ */
const RANKS = [
  { name:'BRONZE I',    icon:'🥉', minRP:0,    maxRP:100 },
  { name:'BRONZE II',   icon:'🥉', minRP:100,  maxRP:200 },
  { name:'BRONZE III',  icon:'🥉', minRP:200,  maxRP:300 },
