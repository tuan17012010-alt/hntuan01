function createIsland() {
  const size = state.mapSize, seg = 100;
  const geo = new THREE.PlaneGeometry(size, size, seg, seg);
  geo.rotateX(-Math.PI/2);
  const pos = geo.attributes.position;
  const colors = []; const c = new THREE.Color();
  for (let i = 0; i < pos.count; i++) {
    const x = pos.getX(i), z = pos.getZ(i);
    const y = terrainHeight(x, z); pos.setY(i, y);
    if (y < 0.3) c.setHex(0xead9a0); else if (y < 6) c.setHex(0xead9a0);
    else if (y < 20) c.setHex(0x6ab04c); else if (y < 45) c.setHex(0x4a8c3a);
    else if (y < 70) c.setHex(0x3a6b2a); else c.setHex(0x8a8a8a);
    colors.push(c.r, c.g, c.b);
  }
  geo.computeVertexNormals();
  geo.setAttribute('color', new THREE.Float32BufferAttribute(colors, 3));
  const mesh = new THREE.Mesh(geo, new THREE.MeshStandardMaterial({ vertexColors:true, roughness:0.95 }));
  scene.add(mesh);
}
function createTrees() {
  const trunkGeo = new THREE.CylinderGeometry(0.35, 0.55, 5, 5);
  const leafGeo = new THREE.ConeGeometry(2.5, 4, 6);
  const trunkMat = new THREE.MeshStandardMaterial({ color:0x5a3a1a });
  const leafMat = new THREE.MeshStandardMaterial({ color:0x2a6b2a, flatShading:true });
  for (let i = 0; i < 200; i++) {
    const a = Math.random()*Math.PI*2, d = 200 + Math.random()*1800;
    const x = Math.cos(a)*d, z = Math.sin(a)*d, y = terrainHeight(x, z);
    if (y < 2 || y > 90) continue;
    const s = 0.7 + Math.random()*0.8;
    const t = new THREE.Mesh(trunkGeo, trunkMat);
    t.position.set(x, y+2.5*s, z); t.scale.setScalar(s); scene.add(t);
    const l = new THREE.Mesh(leafGeo, leafMat);
    l.position.set(x, y+6.5*s, z); l.scale.setScalar(s); scene.add(l);
    state.trees.push({ x, z, r:2*s });
  }
}
