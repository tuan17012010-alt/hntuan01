  { name:'RADIANT',     icon:'🌟', minRP:2500, maxRP:9999 },
];
function loadRank() {
  try {
    const saved = JSON.parse(localStorage.getItem('hntuan_rank') || '{}');
    state.rankPoints = saved.rp || 0;
  } catch(e) { state.rankPoints = 0; }
  updateRankDisplay();
}
function saveRank() {
  try { localStorage.setItem('hntuan_rank', JSON.stringify({ rp: state.rankPoints })); } catch(e) {}
}
function getRank(rp) {
  for (let i = RANKS.length - 1; i >= 0; i--) {
    if (rp >= RANKS[i].minRP) return RANKS[i];
  }
  return RANKS[0];
}
function updateRankDisplay() {
  const r = getRank(state.rankPoints);
  const icon = document.getElementById('rankIcon');
  if (!icon) return;
  icon.textContent = r.icon;
  document.getElementById('rankName').textContent = r.name;
  const total = r.maxRP - r.minRP;
  const cur = state.rankPoints - r.minRP;
  const pct = Math.min(100, (cur / total) * 100);
  document.getElementById('rankPoints').textContent = `${state.rankPoints} RP · ${cur}/${total}`;
  document.getElementById('rankProgress').style.width = pct + '%';
}
function addRankPoints(pts) {
  const oldRank = getRank(state.rankPoints);
  state.rankPoints += pts;
  const newRank = getRank(state.rankPoints);
  updateRankDisplay();
  saveRank();
  if (oldRank.name !== newRank.name) {
    showRankUp(newRank);
  }
}
function showRankUp(rank) {
  const el = document.createElement('div');
  el.className = 'rank-up-notif';
  el.innerHTML = `
    <div class="rank-up-icon">${rank.icon}</div>
    <div class="rank-up-title">THĂNG HẠNG!</div>
    <div class="rank-up-rank">${rank.name}</div>
  `;
  document.body.appendChild(el);
  setTimeout(() => el.remove(), 3000);
  playSound(900, 0.4, 'sine', 0.2);
}

/* ============ AUDIO ============ */
function initAudio() {
  if (state.audioCtx) return;
  try { state.audioCtx = new (window.AudioContext || window.webkitAudioContext)(); } catch(e) {}
}
function playSound(freq, duration, type, volume) {
  if (!state.audioCtx || !state.running) return;
  try {
    const ctx = state.audioCtx;
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.type = type || 'square';
    osc.frequency.setValueAtTime(freq, ctx.currentTime);
    osc.frequency.exponentialRampToValueAtTime(Math.max(30, freq * 0.3), ctx.currentTime + duration);
    gain.gain.setValueAtTime(volume || 0.1, ctx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + duration);
    osc.connect(gain); gain.connect(ctx.destination);
    osc.start(); osc.stop(ctx.currentTime + duration);
  } catch(e) {}
}
function soundShoot()    { playSound(320, 0.1, 'square', 0.05); }
function soundReload()   { playSound(180, 0.15, 'sawtooth', 0.04); }
function soundHit()      { playSound(800, 0.08, 'sine', 0.06); }
function soundHeadshot() { playSound(1200, 0.15, 'sine', 0.1); }
function soundHurt()     { playSound(120, 0.2, 'sawtooth', 0.08); }
function soundKill()     { playSound(600, 0.3, 'sine', 0.1); }

/* ============ DAMAGE NUMBER ============ */
function addDamageNumber(worldPos, dmg, isHead) {
  const sp = worldPos.clone().project(camera);
  if (sp.z > 1) return;
  state.damageNumbers.push({
    x: sp.x * innerWidth/2 + innerWidth/2,
    y: -sp.y * innerHeight/2 + innerHeight/2,
    dmg: Math.round(dmg), isHead, life: 1.0, maxLife: 1.0, vy: -60,
  });
}

/* ============ KILLSTREAK ============ */
function checkKillstreak() {
  state.killStreak++; state.killStreakTimer = 3;
  let text = '';
  if (state.killStreak === 2) text = '🔥 DOUBLE KILL!';
  else if (state.killStreak === 3) text = '⚡ TRIPLE KILL!';
  else if (state.killStreak === 4) text = '💥 QUADRA KILL!';
  else if (state.killStreak >= 5) text = '👑 RAMPAGE!';
  if (text) {
    const el = document.createElement('div');
    el.style.cssText = `position:fixed;top:35%;left:50%;transform:translate(-50%,-50%);
      color:#ff0066;font-size:48px;font-weight:900;letter-spacing:6px;
      text-shadow:0 0 20px #ff0066,0 0 40px #ff0066;z-index:60;pointer-events:none;
      animation:ksAnim 2s forwards;font-family:'Courier New',monospace;`;
