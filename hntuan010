function startReload() {
  const w = WEAPONS[currentWeapon];
  if (ws.reloading || ws.ammo >= w.magSize || ws.reserve <= 0) return;
  ws.reloading = true; ws.reloadTimer = w.reload; soundReload();
}
function finishReload() {
  const w = WEAPONS[currentWeapon];
  const give = Math.min(w.magSize - ws.ammo, ws.reserve);
  ws.ammo += give; ws.reserve -= give;
  if (weaponSlots[activeSlot]) { weaponSlots[activeSlot].ammo = ws.ammo; weaponSlots[activeSlot].reserve = ws.reserve; }
  ws.reloading = false; updateHUD();
}
function tryInteract() {
  if (!state.running || state.paused) return;
  let closest = null, cd = 5;
  for (const p of state.pickups) {
    const d = p.mesh.position.distanceTo(player.mesh.position);
    if (d < cd) { cd = d; closest = p; }
  }
  if (!closest) return;
  if (closest.type === 'weapon') {
    let slot = weaponSlots.findIndex(s => !s);
    if (slot === -1) slot = activeSlot;
    if (weaponSlots[slot]) spawnPickup('weapon', player.mesh.position.x + (Math.random()-0.5)*6, player.mesh.position.z + (Math.random()-0.5)*6, weaponSlots[slot].name);
    weaponSlots[slot] = { name:closest.data, ammo:WEAPONS[closest.data].magSize, reserve:WEAPONS[closest.data].reserve };
    switchWeapon(slot);
    addKillFeed(`🎒 Nhặt ${closest.data} slot ${slot+1}`);
  } else if (closest.type === 'ammo') { ws.reserve += 60; if (weaponSlots[activeSlot]) weaponSlots[activeSlot].reserve = ws.reserve; }
  else if (closest.type === 'health') playerHP = Math.min(100, playerHP + 45);
  else if (closest.type === 'armor') playerArmor = Math.min(100, playerArmor + 55);
  scene.remove(closest.mesh);
  state.pickups.splice(state.pickups.indexOf(closest), 1);
  updateHUD();
}
function hasLineOfSight(from, to) {
  const dir = new THREE.Vector3().subVectors(to, from).normalize();
  const dist = from.distanceTo(to);
  for (const b of state.buildings) {
    const dx = b.x - from.x, dz = b.z - from.z;
    const d = Math.sqrt(dx*dx + dz*dz);
    if (d < dist) {
      const diff = Math.abs(Math.atan2(dz, dx) - Math.atan2(dir.z, dir.x));
      if (diff < 0.3 || diff > Math.PI*2 - 0.3) {
        if (d < Math.max(b.w, b.d)/2 + 2) return false;
      }
    }
  }
  return true;
}
function collidesWithWorld(pos) {
  for (const t of state.trees) if (Math.hypot(pos.x - t.x, pos.z - t.z) < t.r + 0.6) return true;
  for (const b of state.buildings) {
    if (Math.abs(pos.x - b.x) < b.w/2 + 0.5 && Math.abs(pos.z - b.z) < b.d/2 + 0.5) return true;
  }
  return false;
}
function showDamageFlash() {
  const el = document.getElementById('damageFlash');
  el.classList.add('hit'); setTimeout(() => el.classList.remove('hit'), 120);
}
function addKillFeed(text) {
  const feed = document.getElementById('killFeed');
  const msg = document.createElement('div');
  msg.className = 'kill-msg'; msg.innerHTML = text;
  feed.appendChild(msg); setTimeout(() => msg.remove(), 4000);
}

/* ============ BOT AI ============ */
function updateBotAI(bot, dt) {
  if (bot.stunTimer > 0) { bot.stunTimer -= dt; return; }
  const playerPos = player.mesh.position.clone();
  const botPos = bot.mesh.position;
  const distToPlayer = botPos.distanceTo(playerPos);
  const seeDist = 300 + bot.accuracy * 200;

  let nearestBot = null, nearestBotDist = 250;
  for (const other of state.bots) {
    if (other === bot) continue;
    const d = botPos.distanceTo(other.mesh.position);
    if (d < nearestBotDist && hasLineOfSight(botPos, other.mesh.position)) {
      nearestBotDist = d; nearestBot = other;
    }
  }

  let target = null, targetIsBot = false, targetPos = playerPos.clone(), distToTarget = distToPlayer;
  if (distToPlayer < nearestBotDist && distToPlayer < seeDist && hasLineOfSight(botPos, playerPos)) {
    target = player; targetPos = playerPos; distToTarget = distToPlayer;
  } else if (nearestBot && nearestBotDist < seeDist) {
    target = nearestBot; targetIsBot = true; targetPos = nearestBot.mesh.position.clone(); distToTarget = nearestBotDist;
  }

  const canSee = target !== null;
  if (canSee) { bot.lastSeenPlayerPos.copy(targetPos); bot.lastSeenTime = state.time; }
  const timeSince = state.time - bot.lastSeenTime;
  if (canSee) {
    if (bot.tactic === 'sniper') {
      if (distToTarget < 80) bot.state = BSTATE.FLEE;
      else if (distToTarget < 250) bot.state = BSTATE.ATTACK;
      else bot.state = BSTATE.CHASE;
    } else if (bot.tactic === 'camper') {
      if (distToTarget < 40) bot.state = BSTATE.FLEE;
      else bot.state = BSTATE.ATTACK;
    } else if (bot.tactic === 'rusher') {
      if (distToTarget > 15) bot.state = BSTATE.CHASE;
      else bot.state = BSTATE.ATTACK;
    } else {
      if (distToTarget > 60) bot.state = BSTATE.CHASE;
      else if (distToTarget > 15) bot.state = BSTATE.ATTACK;
      else bot.state = BSTATE.FLEE;
    }
  } else if (timeSince < 8) bot.state = BSTATE.CHASE;
  else bot.state = BSTATE.PATROL;
  if (bot.hp < bot.maxHp * 0.25 && canSee) bot.state = BSTATE.FLEE;

  const mv = new THREE.Vector3();
  let targetYaw = bot.mesh.rotation.y;
  if (bot.state === BSTATE.PATROL) {
    const d = new THREE.Vector3().subVectors(bot.patrolTarget, botPos); d.y = 0;
    if (d.length() < 8) {
      const a = Math.random()*Math.PI*2, r = 300 + Math.random()*1500;
      bot.patrolTarget.set(Math.cos(a)*r, 0, Math.sin(a)*r);
    } else { mv.copy(d).normalize(); targetYaw = Math.atan2(mv.x, mv.z); }
  } else if (bot.state === BSTATE.CHASE) {
    const d = new THREE.Vector3().subVectors(bot.lastSeenPlayerPos, botPos); d.y = 0;
    if (d.length() > 3) { mv.copy(d).normalize(); targetYaw = Math.atan2(mv.x, mv.z); }
  } else if (bot.state === BSTATE.ATTACK) {
    bot.strafeTimer -= dt;
    if (bot.strafeTimer <= 0) { bot.strafeDir *= -1; bot.strafeTimer = 0.5 + Math.random()*1.0; }
    const toTarget = new THREE.Vector3().subVectors(targetPos, botPos);
    toTarget.y = 0; toTarget.normalize();
    mv.copy(new THREE.Vector3(-toTarget.z, 0, toTarget.x).multiplyScalar(bot.strafeDir));
    if (bot.tactic === 'sniper') {
      if (distToTarget < 150) mv.sub(toTarget.clone().multiplyScalar(0.8));
      else if (distToTarget > 250) mv.add(toTarget.clone().multiplyScalar(0.5));
    } else if (bot.tactic === 'rusher') {
      if (distToTarget > 20) mv.add(toTarget.clone().multiplyScalar(0.9));
    } else {
      if (distToTarget < 20) mv.sub(toTarget.clone().multiplyScalar(0.7));
      else if (distToTarget > 50) mv.add(toTarget.clone().multiplyScalar(0.5));
    }
    targetYaw = Math.atan2(toTarget.x, toTarget.z);
  } else {
    const toP = new THREE.Vector3().subVectors(botPos, targetPos); toP.y = 0; toP.normalize();
    mv.copy(toP); targetYaw = Math.atan2(mv.x, mv.z);
  }

  if (mv.length() > 0) {
    mv.normalize();
    const next = botPos.clone().add(mv.clone().multiplyScalar(bot.speed * dt));
    if (!collidesWithWorld(next)) { botPos.x = next.x; botPos.z = next.z; }
    else {
      const slide = new THREE.Vector3(-mv.z, 0, mv.x);
      const tryPos = botPos.clone().add(slide.clone().multiplyScalar(bot.speed * dt));
      if (!collidesWithWorld(tryPos)) { botPos.x = tryPos.x; botPos.z = tryPos.z; }
    }
  }

  bot.jumpCd -= dt;
  if (canSee && bot.state === BSTATE.ATTACK && bot.jumpCd <= 0 && Math.random() < 0.015) {
    bot.jumpCd = 1.5 + Math.random() * 2;
    bot.jumpY = 1;
  }
  if (bot.jumpY > 0) {
    bot.jumpY -= dt * 4;
    if (bot.jumpY < 0) bot.jumpY = 0;
  }

  bot.mesh.rotation.y += (targetYaw - bot.mesh.rotation.y) * Math.min(1, 8*dt);
  botPos.y = terrainHeight(botPos.x, botPos.z) + 1 + bot.jumpY * 0.5;

  if (canSee && distToTarget < seeDist) {
    const forward = new THREE.Vector3(0, 0, 1).applyEuler(bot.mesh.rotation);
    const toTargetDir = new THREE.Vector3().subVectors(targetPos, botPos).normalize();
    const facing = forward.dot(toTargetDir);
    if (facing > 0.7) {
      bot.aimDelay += dt;
      const aimTime = bot.tactic === 'sniper' ? 0.8 : 0.4;
      if (bot.aimDelay >= aimTime && bot.attackCd <= 0) {
        bot.reactionCd -= dt;
        if (bot.reactionCd <= 0) {
          const distPenalty = Math.max(0.4, 1 - distToTarget / (bot.tactic === 'sniper' ? 600 : 400));
          if (Math.random() < bot.accuracy * distPenalty) {
            if (targetIsBot) {
              target.hp -= 8 + Math.random() * 10;
              if (target.hp <= 0 && state.bots.includes(target)) {
                bot.kills++; addBotKillFeed(bot.name, target.name);
                scene.remove(target.mesh);
                state.bots.splice(state.bots.indexOf(target), 1);
              }
            } else {
              const dmg = 5 + Math.random() * 8;
              if (!hack.god) {
                if (playerArmor > 0) { playerArmor -= dmg*0.6; playerHP -= dmg*0.4; }
                else playerHP -= dmg;
              }
              showDamageFlash(); soundHurt();
            }
          }
          const bp = botPos.clone(); bp.y += 1.4; spawnMuzzleFlash(bp);
          bot.attackCd = bot.tactic === 'sniper' ? 1.5 + Math.random() : 0.6 + Math.random()*0.8;
          bot.reactionCd = bot.reactionTime;
        }
      }
    } else bot.aimDelay = 0;
  } else bot.aimDelay = 0;

  if (bot.attackCd > 0) bot.attackCd -= dt;

  if (mv.length() > 0.1) {
    bot.walkPhase += dt*12;
    const amp = Math.sin(bot.walkPhase)*0.4;
    bot.legL.position.z = amp; bot.legR.position.z = -amp;
  }

  bot.hpBar.lookAt(camera.position);
  const hpPct = bot.hp / bot.maxHp;
  bot.hpBar.scale.x = hpPct;
  bot.hpBar.position.x = (1 - hpPct) * -0.55;
  if (hpPct > 0.5) bot.hpBar.material.color.setHex(0x2ecc71);
  else if (hpPct > 0.25) bot.hpBar.material.color.setHex(0xf39c12);
  else bot.hpBar.material.color.setHex(0xe74c3c);
}

/* ============ AUTO AIM ============ */
function autoAim(dt) {
  if (!hack.aim || state.bots.length === 0) return;
  const bot = getAutoAimTarget();
  if (!bot) return;
  const tp = hack.headshot ? getBotHeadPos(bot) : getBotBodyPos(bot);
  const pp = player.mesh.position.clone(); pp.y += 1.5;
  const dx = tp.x - pp.x, dy = tp.y - pp.y, dz = tp.z - pp.z;
  const tYaw = Math.atan2(-dx, -dz);
  const tPitch = Math.atan2(dy, Math.sqrt(dx*dx + dz*dz));
  const smooth = 1 / hack.aimSmooth;
  cam.yaw += (tYaw - cam.yaw) * smooth;
  cam.pitch += (tPitch - cam.pitch) * smooth;
  cam.pitch = Math.max(-0.9, Math.min(0.45, cam.pitch));
}

/* ============ ESP ============ */
function drawESP() {
  const esp = document.getElementById('espCanvas');
  const visible = hack.esp || hack.espLine || hack.espHp || hack.fovCircle || hack.skeleton;
  esp.style.display = visible ? 'block' : 'none';
  const counterEl = document.getElementById('enemyCounter');
  if (!visible && state.damageNumbers.length === 0) { counterEl.style.display = 'none'; return; }
  if (esp.width !== innerWidth || esp.height !== innerHeight) {
    esp.width = innerWidth; esp.height = innerHeight;
  }
  const ctx = esp.getContext('2d');
  ctx.clearRect(0, 0, esp.width, esp.height);
  const cx = innerWidth/2, cy = innerHeight/2;

  if (visible && hack.fovCircle) {
    ctx.strokeStyle = 'rgba(0, 255, 0, 0.55)'; ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.arc(cx, cy, hack.aimFov, 0, Math.PI * 2); ctx.stroke();
    ctx.strokeStyle = 'rgba(0, 255, 0, 0.9)';
    ctx.beginPath(); ctx.arc(cx, cy, 4, 0, Math.PI * 2); ctx.stroke();
  }

  let count = 0;
  if (visible) {
    for (const bot of state.bots) {
      const dist = player.mesh.position.distanceTo(bot.mesh.position);
      if (dist > hack.espRange) continue;
      count++;
      if (hack.skeleton) drawSkeleton(ctx, bot, dist);
      const wp = bot.mesh.position.clone(); wp.y += 1.5;
      const sp = wp.project(camera);
      if (sp.z > 1) continue;
      const x = sp.x * innerWidth/2 + cx, y = -sp.y * innerHeight/2 + cy;
      const boxSize = Math.max(25, 1000 / dist);
      if (hack.esp) {
        ctx.strokeStyle = dist < 150 ? 'rgba(255,0,0,0.95)' : dist < 300 ? 'rgba(255,150,0,0.9)' : 'rgba(255,255,0,0.85)';
        ctx.lineWidth = 2;
        ctx.strokeRect(x - boxSize/2, y - boxSize*1.3, boxSize, boxSize*2.2);
        ctx.strokeStyle = 'rgba(255, 255, 0, 0.9)';
        ctx.beginPath(); ctx.arc(x, y - boxSize*1.2, 6, 0, Math.PI*2); ctx.stroke();
        ctx.fillStyle = '#ff0066'; ctx.font = 'bold 11px monospace'; ctx.textAlign = 'center';
        ctx.fillText(`${Math.round(dist)}m`, x, y - boxSize*1.3 - 4);
      }
      if (hack.espLine) {
        ctx.strokeStyle = 'rgba(0, 255, 255, 0.7)'; ctx.lineWidth = 1.5; ctx.setLineDash([6, 6]);
        ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(x, y); ctx.stroke(); ctx.setLineDash([]);
      }
      if (hack.espHp) {
        const hpPct = bot.hp / bot.maxHp;
        const bw = boxSize, bh = 4, by = y + boxSize*0.95;
        ctx.fillStyle = 'rgba(0,0,0,0.85)'; ctx.fillRect(x - bw/2, by, bw, bh);
        ctx.fillStyle = hpPct > 0.5 ? '#0f0' : hpPct > 0.25 ? '#ff0' : '#f00';
        ctx.fillRect(x - bw/2, by, bw * hpPct, bh);
      }
    }
  }
  if (hack.enemyCount && visible) {
    counterEl.style.display = 'block';
    document.getElementById('enemyCount').textContent = count;
    counterEl.classList.toggle('danger', count >= 5);
  } else counterEl.style.display = 'none';

  for (const dn of state.damageNumbers) {
    const alpha = dn.life / dn.maxLife;
    ctx.globalAlpha = alpha;
    ctx.font = `bold ${dn.isHead ? 22 : 16}px 'Courier New'`;
    ctx.textAlign = 'center';
    ctx.fillStyle = dn.isHead ? '#ff0044' : '#ffcc00';
    ctx.strokeStyle = '#000'; ctx.lineWidth = 3;
    ctx.strokeText(dn.dmg, dn.x, dn.y);
    ctx.fillText(dn.dmg, dn.x, dn.y);
  }
  ctx.globalAlpha = 1;

  if (playerHP < 40 && state.running) {
    const intensity = (40 - playerHP) / 40;
    const grad = ctx.createRadialGradient(cx, cy, innerWidth*0.3, cx, cy, innerWidth*0.7);
    grad.addColorStop(0, 'rgba(255,0,0,0)');
    grad.addColorStop(1, `rgba(255,0,0,${intensity * 0.4})`);
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, innerWidth, innerHeight);
  }
}
function drawSkeleton(ctx, bot, dist) {
  const botPos = bot.mesh.position.clone();
  const botYaw = bot.mesh.rotation.y;
  const points = {
    head: new THREE.Vector3(0, 2.25, 0), neck: new THREE.Vector3(0, 1.9, 0),
    spine: new THREE.Vector3(0, 1.5, 0), hips: new THREE.Vector3(0, 1.0, 0),
    shoulderL: new THREE.Vector3(-0.4, 1.75, 0), shoulderR: new THREE.Vector3( 0.4, 1.75, 0),
    elbowL: new THREE.Vector3(-0.55, 1.4, -0.1), elbowR: new THREE.Vector3( 0.55, 1.4, -0.1),
    handL: new THREE.Vector3(-0.6, 1.0, -0.25), handR: new THREE.Vector3( 0.6, 1.0, -0.25),
    kneeL: new THREE.Vector3(-0.2, 0.55, 0), kneeR: new THREE.Vector3( 0.2, 0.55, 0),
    footL: new THREE.Vector3(-0.2, 0.05, 0), footR: new THREE.Vector3( 0.2, 0.05, 0),
  };
  const rot = new THREE.Euler(0, botYaw, 0);
  const screenPts = {};
  for (const key in points) {
    const p = points[key].clone().applyEuler(rot).add(botPos);
    const sp = p.project(camera);
    if (sp.z > 1) return;
    screenPts[key] = { x: sp.x * innerWidth/2 + innerWidth/2, y: -sp.y * innerHeight/2 + innerHeight/2 };
  }
  const col = dist < 100 ? '#ff0000' : dist < 250 ? '#ff8800' : '#00ffff';
  ctx.strokeStyle = col; ctx.lineWidth = 2;
  ctx.shadowBlur = 8; ctx.shadowColor = col;
  const bone = (a, b) => {
    ctx.beginPath();
    ctx.moveTo(screenPts[a].x, screenPts[a].y);
    ctx.lineTo(screenPts[b].x, screenPts[b].y);
    ctx.stroke();
  };
  ctx.beginPath(); ctx.arc(screenPts.head.x, screenPts.head.y, 8, 0, Math.PI*2); ctx.stroke();
  bone('head', 'neck'); bone('neck', 'spine'); bone('spine', 'hips');
  bone('neck', 'shoulderL'); bone('neck', 'shoulderR');
  bone('shoulderL', 'elbowL'); bone('shoulderR', 'elbowR');
  bone('elbowL', 'handL'); bone('elbowR', 'handR');
  bone('hips', 'kneeL'); bone('hips', 'kneeR');
  bone('kneeL', 'footL'); bone('kneeR', 'footR');
  ctx.shadowBlur = 0;
}

/* ============ UPDATE ============ */
function updateHUD() {
  document.getElementById('hpFill').style.width = Math.max(0, playerHP) + '%';
  document.getElementById('armorFill').style.width = Math.max(0, playerArmor) + '%';
  document.getElementById('killCount').textContent = state.kills;
  document.getElementById('hsCount').textContent = state.headshots;
  document.getElementById('weaponName').textContent = WEAPONS[currentWeapon].name;
  document.getElementById('ammoMag').textContent = hack.ammo ? '∞' : ws.ammo;
  document.getElementById('ammoReserve').textContent = hack.ammo ? '∞' : ws.reserve;
}
function update(dt) {
  if (!state.running || state.paused || state.gameOver) return;
  state.time += dt;
  autoAim(dt);
  const forward = new THREE.Vector3(-Math.sin(cam.yaw), 0, -Math.cos(cam.yaw));
  const right = new THREE.Vector3(Math.cos(cam.yaw), 0, -Math.sin(cam.yaw));
  const move = new THREE.Vector3();
  if (keys['w'] || keys['arrowup']) move.add(forward);
  if (keys['s'] || keys['arrowdown']) move.sub(forward);
  if (keys['a'] || keys['arrowleft']) move.sub(right);
  if (keys['d'] || keys['arrowright']) move.add(right);
  const sprint = keys['shift'];
  const baseSpeed = sprint ? settings.sprint : settings.sprint * 0.55;
  const speed = baseSpeed * hack.speed;
  if (move.length() > 0) {
    move.normalize().multiplyScalar(speed * dt);
    const nx = player.mesh.position.x + move.x, nz = player.mesh.position.z + move.z;
    if (!collidesWithWorld(new THREE.Vector3(nx, 0, nz))) {
      player.mesh.position.x = nx; player.mesh.position.z = nz;
    }
    player.mesh.rotation.y = Math.atan2(move.x, move.z);
    player.walkPhase += dt*14;
    const amp = Math.sin(player.walkPhase)*0.4;
    player.legL.position.z = amp; player.legR.position.z = -amp;
  } else {
    player.legL.position.z *= 0.85; player.legR.position.z *= 0.85;
  }
  const maxD = state.zone.radius;
  const pd = Math.sqrt(player.mesh.position.x**2 + player.mesh.position.z**2);
  if (pd > maxD) { const s = maxD/pd; player.mesh.position.x *= s; player.mesh.position.z *= s; }
  player.mesh.position.y = terrainHeight(player.mesh.position.x, player.mesh.position.z) + 1;
  if (ws.cooldown > 0) ws.cooldown -= dt;
  if (ws.recoil > 0) { ws.recoil -= dt*0.5; if (ws.recoil < 0) ws.recoil = 0; player.gun.rotation.x = -ws.recoil*3; }
  else player.gun.rotation.x = 0;
  if (cam.shake > 0) { cam.shake *= 0.85; if (cam.shake < 0.005) cam.shake = 0; }
  if (ws.reloading) { ws.reloadTimer -= dt; if (ws.reloadTimer <= 0) finishReload(); }
  if (mouseDown && state.running && !state.paused) {
    const w = WEAPONS[currentWeapon];
    if (w.auto || ws.cooldown <= 0) shoot();
    if (!w.auto) mouseDown = false;
  }
  for (let i = state.bullets.length - 1; i >= 0; i--) {
    const b = state.bullets[i];
    if (hack.homing) {
      let nearest = null, nearestD = hack.homingRange;
      for (const bot of state.bots) {
        const tp = hack.headshot ? getBotHeadPos(bot) : getBotBodyPos(bot);
        const d = b.pos.distanceTo(tp);
        if (d < nearestD) { nearestD = d; nearest = tp; }
      }
      if (nearest) {
        const wantDir = new THREE.Vector3().subVectors(nearest, b.pos).normalize();
        const spd = b.vel.length();
        const curDir = b.vel.clone().normalize();
        curDir.lerp(wantDir, Math.min(1, hack.homingStrength * dt));
        curDir.normalize();
        b.vel.copy(curDir.multiplyScalar(spd));
        b.mesh.quaternion.setFromUnitVectors(new THREE.Vector3(0,1,0), curDir);
      }
    }
    const prevPos = b.pos.clone();
    b.pos.add(b.vel.clone().multiplyScalar(dt));
    b.mesh.position.copy(b.pos);
    b.life -= dt;
    if (b.trail) {
      const arr = b.trail.geometry.attributes.position.array;
      arr[0] = prevPos.x; arr[1] = prevPos.y; arr[2] = prevPos.z;
      arr[3] = b.pos.x; arr[4] = b.pos.y; arr[5] = b.pos.z;
      b.trail.geometry.attributes.position.needsUpdate = true;
      b.trail.material.opacity = Math.max(0, b.life / BULLET_LIFE);
    }
    let hit = false;
    for (const bot of state.bots) {
      const headPos = getBotHeadPos(bot);
      const dHead = b.pos.distanceTo(headPos);
      const dBody = b.pos.distanceTo(getBotBodyPos(bot));
      if (dHead < 0.6) {
        bot.hp -= b.damage * 3; hit = true; state.headshots++;
        spawnHeadshotEffect(headPos); spawnBloodEffect(headPos);
        addDamageNumber(headPos, b.damage * 3, true);
        soundHeadshot();
        if (bot.hp <= 0) {
          scene.remove(bot.mesh); state.bots.splice(state.bots.indexOf(bot), 1);
          state.kills++; checkKillstreak(); soundKill(); addRankPoints(10);
          addKillFeed('💀 HEADSHOT ' + bot.name); updateHUD();
        }
        break;
      } else if (dBody < 0.8) {
        bot.hp -= b.damage; hit = true;
        spawnBloodEffect(b.pos);
        addDamageNumber(b.pos, b.damage, false);
        soundHit();
        bot.stunTimer = 0.15;
        if (bot.hp <= 0) {
          scene.remove(bot.mesh); state.bots.splice(state.bots.indexOf(bot), 1);
          state.kills++; checkKillstreak(); soundKill(); addRankPoints(10);
          addKillFeed('🔫 Hạ ' + bot.name); updateHUD();
        }
        break;
      }
    }
    if (!hit && !hack.wallHack) {
      if (b.pos.y < terrainHeight(b.pos.x, b.pos.z)) hit = true;
      if (!hit) for (const t of state.trees) if (Math.hypot(b.pos.x - t.x, b.pos.z - t.z) < t.r) { hit = true; break; }
    }
    if (hit || b.life <= 0) {
      scene.remove(b.mesh);
      if (b.trail) scene.remove(b.trail);
      state.bullets.splice(i, 1);
    }
  }
  for (const bot of state.bots) updateBotAI(bot, dt);
  for (const ally of state.team) updateTeamAI(ally, dt);
  for (let i = state.bots.length - 1; i >= 0; i--) {
    if (state.bots[i].hp <= 0) { scene.remove(state.bots[i].mesh); state.bots.splice(i, 1); }
  }
  for (let i = state.particles.length - 1; i >= 0; i--) {
    const p = state.particles[i];
    p.mesh.position.add(p.vel.clone().multiplyScalar(dt));
    p.vel.multiplyScalar(0.95); p.life -= dt;
    p.mesh.material.opacity = Math.max(0, p.life/p.maxLife);
    if (p.life <= 0) { scene.remove(p.mesh); state.particles.splice(i, 1); }
  }
  for (const p of state.pickups) {
    p.t += dt; p.mesh.rotation.y += dt*1.8;
    p.mesh.position.y = terrainHeight(p.mesh.position.x, p.mesh.position.z) + 1 + Math.sin(p.t*2.5)*0.3;
  }

  // FPS + auto giảm mưa
  state.fpsFrames++;
  if (state.time - state.fpsLastTime >= 1) {
    state.fps = state.fpsFrames;
    state.fpsFrames = 0;
    state.fpsLastTime = state.time;
    if (state.fps < 25 && state.rain && state.rainQuality !== 'off') {
      if (state.rainQuality === 'high') state.rainQuality = 'medium';
      else if (state.rainQuality === 'medium') state.rainQuality = 'low';
      else if (state.rainQuality === 'low') state.rainQuality = 'off';
      if (state.rain) scene.remove(state.rain);
      state.rain = null;
      if (state.rainQuality !== 'off') createRain();
    }
  }
  if (!hack.rain && state.rain) {
    scene.remove(state.rain); state.rain = null;
  } else if (hack.rain && !state.rain && state.rainQuality !== 'off') {
    createRain();
  }
  if (state.rain) {
    const pos = state.rain.geometry.attributes.position;
    for (let i = 0; i < pos.count; i++) {
      let y = pos.getY(i) - dt * 25;
      if (y < 0) {
        y = 40;
        pos.setX(i, camera.position.x + (Math.random() - 0.5) * 60);
        pos.setZ(i, camera.position.z + (Math.random() - 0.5) * 60);
      }
      pos.setY(i, y);
    }
    pos.needsUpdate = true;
  }

  if (state.grass) state.grass.material.opacity = 0.5 + Math.sin(state.time * 2) * 0.15;
  state.dayTime += dt / 300;
  if (state.dayTime > 1) state.dayTime -= 1;
  const dt2 = state.dayTime;
  let skyColor, sunIntensity;
  if (dt2 < 0.4) {
    skyColor = new THREE.Color().lerpColors(new THREE.Color(0x87ceeb), new THREE.Color(0xffaa66), dt2 / 0.4);
    sunIntensity = 1.4 - dt2 * 0.3;
  } else if (dt2 < 0.6) {
    skyColor = new THREE.Color().lerpColors(new THREE.Color(0xffaa66), new THREE.Color(0x1a1a3a), (dt2 - 0.4) / 0.2);
    sunIntensity = 1.1 - (dt2 - 0.4) * 3;
  } else if (dt2 < 0.9) {
    skyColor = new THREE.Color(0x0a0a20); sunIntensity = 0.2;
  } else {
    skyColor = new THREE.Color().lerpColors(new THREE.Color(0x0a0a20), new THREE.Color(0x87ceeb), (dt2 - 0.9) / 0.1);
    sunIntensity = 0.2 + (dt2 - 0.9) * 12;
  }
  scene.background.copy(skyColor);
  if (scene.fog) scene.fog.color.copy(skyColor);
  if (window._sun) window._sun.intensity = Math.max(0.2, sunIntensity);

  for (let i = state.damageNumbers.length - 1; i >= 0; i--) {
    const dn = state.damageNumbers[i];
    dn.life -= dt; dn.y += dn.vy * dt; dn.vy += 100 * dt;
    if (dn.life <= 0) state.damageNumbers.splice(i, 1);
  }
  if (state.killStreakTimer > 0) {
    state.killStreakTimer -= dt;
    if (state.killStreakTimer <= 0) state.killStreak = 0;
  }

  state.rankRefresh -= dt;
  if (state.rankRefresh <= 0) {
    state.rankRefresh = 0.5;
    updateLeaderboard();
    updateTeamList();
  }

  state.zone.timer -= dt;
  if (state.zone.timer <= 0 && state.zone.radius > 150) {
    state.zone.radius -= 25; state.zone.timer = 3;
    const geo = new THREE.RingGeometry(state.zone.radius - 8, state.zone.radius, 64);
    geo.rotateX(-Math.PI/2);
    zoneMesh.geometry.dispose(); zoneMesh.geometry = geo;
  }
  const outside = Math.sqrt(player.mesh.position.x**2 + player.mesh.position.z**2) > state.zone.radius;
  document.getElementById('zoneWarning').classList.toggle('show', outside);
  if (outside && !hack.god) playerHP -= dt * 6;
  let closest = null, cd = 5;
  for (const p of state.pickups) {
    const d = p.mesh.position.distanceTo(player.mesh.position);
    if (d < cd) { cd = d; closest = p; }
  }
  const prompt = document.getElementById('prompt');
  if (closest) {
    prompt.classList.add('show');
    const n = closest.type === 'weapon' ? closest.data : closest.type === 'ammo' ? 'Đạn' : closest.type === 'health' ? 'Máu' : 'Giáp';
    prompt.textContent = `[E] Nhặt ${n}`;
  } else prompt.classList.remove('show');
  const camRight = new THREE.Vector3(Math.cos(cam.yaw), 0, -Math.sin(cam.yaw));
  const camBack  = new THREE.Vector3(Math.sin(cam.yaw), 0, Math.cos(cam.yaw));
  const aiming = keys.aim || hack.aim;
  const shoulder = aiming ? cam.aimOffset : cam.shoulderOffset;
  const distance = aiming ? cam.aimDistance : cam.distance;
  const camOffset = new THREE.Vector3().addScaledVector(camBack, distance).addScaledVector(camRight, shoulder);
  camOffset.y = distance * 0.35 + Math.sin(cam.pitch) * distance;
  camera.position.lerp(player.mesh.position.clone().add(camOffset), 0.28);
  camera.lookAt(player.mesh.position.clone()
    .add(new THREE.Vector3(0, 1.5, 0))
    .addScaledVector(camRight, shoulder * 0.9)
    .addScaledVector(camBack, -8));
  if (playerHP <= 0 && !hack.god) { playerHP = 0; state.gameOver = true; state.running = false; endGame(false); }
  if (state.bots.length === 0 && state.time > 3) { state.gameOver = true; state.running = false; endGame(true); }
  updateHUD();
  document.getElementById('aliveCount').textContent = state.bots.length + 1;
  const m = Math.floor(state.time/60), s = Math.floor(state.time%60);
  document.getElementById('surviveTime').textContent = `${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
}

/* ============ ANIMATE ============ */
let lastFrameTime = 0;
function animate(now) {
  requestAnimationFrame(animate);
  if (!now) now = performance.now();
  let dt = (now - lastFrameTime) / 1000;
  lastFrameTime = now;
  if (dt > 0.1) dt = 0.1;
  if (dt < 0) dt = 0;
  update(dt);
  renderer.render(scene, camera);
  drawESP();
}

/* ============ GAME FLOW ============ */
function startGame() {
  state.running = true; state.paused = false; state.gameOver = false;
  state.time = 0; state.kills = 0; state.headshots = 0;
  state.killStreak = 0; state.killStreakTimer = 0;
  state.damageNumbers = [];
  state.dayTime = 0.3;
  state.zone.radius = 2400; state.zone.timer = 150;
  playerHP = 100; playerArmor = 100;
  weaponSlots = [null, null, null, null, null];
  weaponSlots[0] = { name:'Pistol', ammo:15, reserve:90 };
  activeSlot = 0; currentWeapon = 'Pistol';
  ws = { ammo:15, reserve:90, reloading:false, reloadTimer:0, cooldown:0, recoil:0 };
  for (const b of state.bots) scene.remove(b.mesh);
  for (const b of state.bullets) { scene.remove(b.mesh); if (b.trail) scene.remove(b.trail); }
  for (const p of state.pickups) scene.remove(p.mesh);
  for (const p of state.particles) scene.remove(p.mesh);
  for (const ally of state.team) scene.remove(ally.mesh);
  state.bots = []; state.bullets = []; state.pickups = []; state.particles = [];
  state.team = [];
  player.mesh.position.set(0, terrainHeight(0, 0) + 1, 0);
  cam.yaw = 0; cam.pitch = -0.2;
  const geo = new THREE.RingGeometry(state.zone.radius - 8, state.zone.radius, 64);
  geo.rotateX(-Math.PI/2);
  zoneMesh.geometry.dispose(); zoneMesh.geometry = geo;

  // Team
  const teamSize = state.gameMode === 'solo' ? 0 :
                   state.gameMode === 'duo' ? 1 : 3;
  for (let i = 0; i < teamSize; i++) spawnTeammate(i);

  // 200 bots
  for (let i = 0; i < 50; i++) {
    const a = Math.random() * Math.PI * 2;
    const d = 100 + Math.random() * 250;
    spawnBot(new THREE.Vector3(Math.cos(a)*d, 0, Math.sin(a)*d));
  }
  for (let i = 0; i < 150; i++) spawnBot();

  const wtypes = ['SMG','Rifle','Shotgun','Sniper','Pistol'];
  for (let i = 0; i < 100; i++) {
    const a = Math.random()*Math.PI*2, d = 200 + Math.random()*1800;
    spawnPickup('weapon', Math.cos(a)*d, Math.sin(a)*d, wtypes[Math.floor(Math.random()*wtypes.length)]);
  }
  for (let i = 0; i < 80; i++) {
    const a = Math.random()*Math.PI*2, d = 150 + Math.random()*1850;
    spawnPickup('ammo', Math.cos(a)*d, Math.sin(a)*d, null);
  }
  for (let i = 0; i < 40; i++) {
    const a = Math.random()*Math.PI*2, d = 150 + Math.random()*1850;
    spawnPickup(i % 2 === 0 ? 'health' : 'armor', Math.cos(a)*d, Math.sin(a)*d, null);
  }
  document.getElementById('hud').classList.add('show');
  document.getElementById('crosshair').classList.add('show');
  document.getElementById('minimap').classList.add('show');
  document.getElementById('leaderboard').classList.add('show');
  document.getElementById('teamList').classList.add('show');
  document.getElementById('rankBadge').classList.add('show');
  document.getElementById('pauseOverlay').classList.remove('show');
  document.getElementById('endOverlay').classList.remove('show');
  document.getElementById('killFeed').innerHTML = '';
  document.getElementById('botKillFeed').innerHTML = '';
  state.rankRefresh = 0;
  loadRank();
  updateTeamList();
  updateHUD();
  renderer.domElement.requestPointerLock();
}
function endGame(win) {
  document.getElementById('endTitle').textContent = win ? 'CHIẾN THẮNG!' : 'BẠN ĐÃ CHẾT';
  document.getElementById('endTitle').style.color = win ? '#2ecc71' : '#c0392b';
  const m = Math.floor(state.time/60), s = Math.floor(state.time%60);
  // Thưởng RP khi thắng
  if (win) { addRankPoints(50); }
  document.getElementById('endStats').innerHTML = `Kills: ${state.kills}<br>Headshot: ${state.headshots}<br>RP: ${state.rankPoints}<br>Thời gian: ${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
  document.getElementById('endOverlay').classList.add('show');
  document.exitPointerLock();
}
function togglePause() {
  if (!state.running) return;
  state.paused = !state.paused;
  document.getElementById('pauseOverlay').classList.toggle('show', state.paused);
  if (state.paused) document.exitPointerLock();
  else renderer.domElement.requestPointerLock();
}
function returnToLobby() {
  state.running = false; state.paused = false;
  document.getElementById('hud').classList.remove('show');
  document.getElementById('crosshair').classList.remove('show');
  document.getElementById('minimap').classList.remove('show');
  document.getElementById('leaderboard').classList.remove('show');
  document.getElementById('teamList').classList.remove('show');
  document.getElementById('rankBadge').classList.remove('show');
  document.getElementById('pauseOverlay').classList.remove('show');
  document.getElementById('endOverlay').classList.remove('show');
  document.exitPointerLock();
  showLobby();
}
document.getElementById('btnResume').addEventListener('click', togglePause);
document.getElementById('btnMenu').addEventListener('click', returnToLobby);
document.getElementById('btnReplay').addEventListener('click', () => { document.getElementById('endOverlay').classList.remove('show'); startGame(); });
document.getElementById('btnMenu2').addEventListener('click', returnToLobby);

/* ============ LOGIN + LOBBY ============ */
const loginState = { user:null, type:null };
function loadUser() { try { const s = localStorage.getItem('hntuan_user'); if (s) loginState.user = JSON.parse(s); } catch(e){} }
function saveUser() { try { localStorage.setItem('hntuan_user', JSON.stringify(loginState.user)); } catch(e){} }
function showLoginLoading(msg) {
  let el = document.getElementById('loginLoading');
  if (!el) {
    el = document.createElement('div');
    el.id = 'loginLoading';
    el.innerHTML = '<div class="load-spinner"></div><div class="msg">ĐANG TẢI...</div>';
    document.body.appendChild(el);
  }
  el.querySelector('.msg').textContent = msg;
  el.classList.add('show');
}
function hideLoginLoading() {
  const el = document.getElementById('loginLoading');
  if (el) el.classList.remove('show');
}
function doLogin(type) {
  loginState.type = type;
  if (type === 'facebook') {
    showLoginLoading('ĐANG KẾT NỐI FACEBOOK...');
    setTimeout(() => {
      loginState.user = { id:'fb_' + Date.now(), name:'FB_Player' + Math.floor(Math.random()*999), type:'facebook', avatar:'F' };
      finishLogin();
    }, 1200);
  } else if (type === 'guest') {
    showLoginLoading('ĐANG VÀO VỚI TƯ CÁCH KHÁCH...');
    setTimeout(() => {
      loginState.user = { id:'guest_' + Date.now(), name:'Khách' + Math.floor(Math.random()*9999), type:'guest', avatar:'K' };
      finishLogin();
    }, 800);
  } else if (type === 'more') {
    const custom = prompt('Nhập tên của bạn:', 'HNTuan' + Math.floor(Math.random()*999));
    if (custom && custom.trim()) {
      loginState.user = { id:'custom_' + Date.now(), name:custom.trim().slice(0,16), type:'more', avatar:custom.trim().charAt(0).toUpperCase() };
      finishLogin();
    }
  }
}
function finishLogin() {
  saveUser();
  showLoginLoading('ĐANG TẢI SẢNH CHỜ...');
  setTimeout(() => {
    hideLoginLoading();
    document.getElementById('loginScreen').classList.remove('show');
    showLobby();
  }, 800);
}
function logout() {
  if (!confirm('Đăng xuất?')) return;
  loginState.user = null;
  localStorage.removeItem('hntuan_user');
  location.reload();
}
function setupLogin() {
  loadUser();
  document.getElementById('btnLoginFB').addEventListener('click', () => doLogin('facebook'));
  document.getElementById('btnLoginGuest').addEventListener('click', () => doLogin('guest'));
  document.getElementById('btnLoginMore').addEventListener('click', () => doLogin('more'));
  const rb = document.querySelector('.login-recover');
  if (rb) rb.addEventListener('click', () => {
    const id = prompt('Nhập ID tài khoản cần khôi phục:');
    if (id) alert('Đã gửi yêu cầu!\nID: ' + id);
  });
  if (loginState.user) {
    document.getElementById('loginScreen').classList.remove('show');
    showLobby();
  }
}

/* ============ LOBBY 3D ============ */
let lobbyScene, lobbyCamera, lobbyRenderer, lobbyCharacter, lobbyAnimId = null;
function initLobby3D() {
  const canvas = document.getElementById('lobbyCanvas');
  if (!canvas) return;
  lobbyScene = new THREE.Scene();
  lobbyCamera = new THREE.PerspectiveCamera(45, innerWidth/innerHeight, 0.1, 100);
  lobbyCamera.position.set(0, 1.6, 4.5);
  lobbyCamera.lookAt(0, 1.1, 0);
  lobbyRenderer = new THREE.WebGLRenderer({ canvas, antialias:true, alpha:true });
  lobbyRenderer.setSize(innerWidth, innerHeight);
  lobbyRenderer.setPixelRatio(1);

  lobbyScene.add(new THREE.AmbientLight(0xffffff, 0.5));
  const key = new THREE.DirectionalLight(0xfff5e0, 1.5);
  key.position.set(3, 5, 4); lobbyScene.add(key);
  const rim = new THREE.DirectionalLight(0x66aaff, 1.0);
  rim.position.set(-3, 3, -4); lobbyScene.add(rim);
  const bottom = new THREE.PointLight(0xf39c12, 2, 8);
  bottom.position.set(0, 0.1, 1.5); lobbyScene.add(bottom);

  const platformGeo = new THREE.CylinderGeometry(1.6, 1.6, 0.15, 24);
  const platformMat = new THREE.MeshStandardMaterial({ color:0x1a2a3a, metalness:0.7, roughness:0.3, emissive:0xf39c12, emissiveIntensity:0.15 });
  const platform = new THREE.Mesh(platformGeo, platformMat);
  platform.position.y = 0.05; lobbyScene.add(platform);

  const ringGeo = new THREE.RingGeometry(1.7, 1.9, 32);
  ringGeo.rotateX(-Math.PI/2);
  const ring = new THREE.Mesh(ringGeo, new THREE.MeshBasicMaterial({ color:0xf39c12, transparent:true, opacity:0.7, side:THREE.DoubleSide }));
  ring.position.y = 0.16; lobbyScene.add(ring);
  lobbyScene.userData.ring = ring;

  lobbyCharacter = createLobbyCharacter();
  lobbyCharacter.position.set(0, 0.15, 0);
  lobbyScene.add(lobbyCharacter);

  if (lobbyAnimId) cancelAnimationFrame(lobbyAnimId);
  const startTime = performance.now();
  function lobbyAnimate() {
    lobbyAnimId = requestAnimationFrame(lobbyAnimate);
    const t = (performance.now() - startTime) / 1000;
    if (lobbyCharacter) {
      lobbyCharacter.rotation.y = Math.sin(t * 0.5) * 0.35;
      lobbyCharacter.position.y = 0.15 + Math.sin(t * 1.5) * 0.03;
    }
    if (lobbyScene.userData.ring) {
      lobbyScene.userData.ring.rotation.z = t * 0.5;
      lobbyScene.userData.ring.material.opacity = 0.5 + Math.sin(t * 2) * 0.2;
    }
    lobbyRenderer.render(lobbyScene, lobbyCamera);
  }
  lobbyAnimate();
}
function createLobbyCharacter() {
  const g = new THREE.Group();
  const skinMat = new THREE.MeshStandardMaterial({ color:0xf0c090 });
  const blackMat = new THREE.MeshStandardMaterial({ color:0x1a1a1a });
  const coatMat = new THREE.MeshStandardMaterial({ color:0x1a1f2a, metalness:0.15 });
  const goldMat = new THREE.MeshStandardMaterial({ color:0xf39c12, metalness:0.8 });
  const legGeo = new THREE.BoxGeometry(0.22, 0.85, 0.25);
  const legL = new THREE.Mesh(legGeo, blackMat); legL.position.set(-0.16, 0.55, 0); g.add(legL);
  const legR = new THREE.Mesh(legGeo, blackMat); legR.position.set(0.16, 0.55, 0); g.add(legR);
  const bootGeo = new THREE.BoxGeometry(0.26, 0.28, 0.32);
  const bootL = new THREE.Mesh(bootGeo, blackMat); bootL.position.set(-0.16, 0.14, 0.03); g.add(bootL);
  const bootR = new THREE.Mesh(bootGeo, blackMat); bootR.position.set(0.16, 0.14, 0.03); g.add(bootR);
  const torso = new THREE.Mesh(new THREE.BoxGeometry(0.65, 0.9, 0.32), coatMat);
  torso.position.y = 1.35; g.add(torso);
  const collar = new THREE.Mesh(new THREE.BoxGeometry(0.5, 0.2, 0.36), coatMat);
  collar.position.y = 1.85; g.add(collar);
  for (let i = 0; i < 3; i++) {
    const stripe = new THREE.Mesh(new THREE.BoxGeometry(0.65, 0.03, 0.02), goldMat);
    stripe.position.set(0, 1.15 + i*0.12, 0.17); g.add(stripe);
  }
  const shGeo = new THREE.BoxGeometry(0.22, 0.15, 0.32);
  const shL = new THREE.Mesh(shGeo, coatMat); shL.position.set(-0.42, 1.75, 0); g.add(shL);
  const shR = new THREE.Mesh(shGeo, coatMat); shR.position.set(0.42, 1.75, 0); g.add(shR);
  const armGeo = new THREE.BoxGeometry(0.18, 0.75, 0.22);
  const armL = new THREE.Mesh(armGeo, coatMat); armL.position.set(-0.44, 1.3, 0); armL.rotation.z = 0.15; g.add(armL);
  const armR = new THREE.Mesh(armGeo, coatMat); armR.position.set(0.44, 1.3, 0); armR.rotation.z = -0.15; g.add(armR);
  const handGeo = new THREE.SphereGeometry(0.1, 6, 6);
  const handL = new THREE.Mesh(handGeo, skinMat); handL.position.set(-0.5, 0.9, 0); g.add(handL);
  const handR = new THREE.Mesh(handGeo, skinMat); handR.position.set(0.5, 0.9, 0); g.add(handR);
  const head = new THREE.Mesh(new THREE.SphereGeometry(0.22, 12, 12), skinMat);
  head.position.y = 2.15; g.add(head);
  const hair = new THREE.Mesh(new THREE.SphereGeometry(0.24, 12, 12, 0, Math.PI*2, 0, Math.PI*0.65),
    new THREE.MeshStandardMaterial({ color:0x1a0f08 }));
  hair.position.y = 2.2; g.add(hair);
  const glasses = new THREE.Mesh(new THREE.BoxGeometry(0.44, 0.1, 0.05),
    new THREE.MeshStandardMaterial({ color:0x111, metalness:0.9 }));
  glasses.position.set(0, 2.18, 0.2); g.add(glasses);
  const belt = new THREE.Mesh(new THREE.BoxGeometry(0.68, 0.08, 0.34), blackMat);
  belt.position.y = 0.9; g.add(belt);
  const buckle = new THREE.Mesh(new THREE.BoxGeometry(0.12, 0.08, 0.02), goldMat);
  buckle.position.set(0, 0.9, 0.18); g.add(buckle);
  return g;
}
function showLobby() {
  document.getElementById('loginScreen').classList.remove('show');
  document.getElementById('lobbyScreen').classList.add('show');
  if (loginState.user) {
    document.getElementById('lobbyAvatar').textContent = loginState.user.avatar;
    document.getElementById('lobbyName').textContent = loginState.user.name;
    document.getElementById('lobbyID').textContent = 'ID: ' + loginState.user.id.slice(-8);
    document.getElementById('charName').textContent = loginState.user.name;
  }
  document.getElementById('lobbyGold').textContent = (Math.floor(Math.random()*90000) + 10000).toLocaleString();
  document.getElementById('lobbyDiamond').textContent = Math.floor(Math.random()*50) + '💎';
  setTimeout(() => {
    if (!lobbyScene) initLobby3D();
    else {
      lobbyCamera.aspect = innerWidth / innerHeight;
      lobbyCamera.updateProjectionMatrix();
      lobbyRenderer.setSize(innerWidth, innerHeight);
    }
  }, 50);
}
function hideLobby() {
  document.getElementById('lobbyScreen').classList.remove('show');
  if (lobbyAnimId) cancelAnimationFrame(lobbyAnimId);
  lobbyAnimId = null;
}
function setupLobbyButtons() {
  document.getElementById('btnLobbyStart').addEventListener('click', () => {
    hideLobby();
    setTimeout(() => startGame(), 200);
  });
  document.getElementById('btnLobbyLogout').addEventListener('click', logout);
  document.querySelectorAll('.lobby-menu-item').forEach(item => {
    item.addEventListener('click', () => alert('🚧 ' + item.textContent.trim() + '\nTính năng đang phát triển!'));
  });
  document.querySelectorAll('.lobby-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.lobby-tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
    });
  });
  setupTeamSelect();
  addEventListener('resize', () => {
    if (lobbyRenderer) {
      lobbyCamera.aspect = innerWidth / innerHeight;
      lobbyCamera.updateProjectionMatrix();
      lobbyRenderer.setSize(innerWidth, innerHeight);
    }
  });
}

/* ============ BOOT ============ */
init();
setupLogin();
setupLobbyButtons();
loadRank();
</script>

